# =============================================================================
# TriageCounsel AI — Production Environment Variables
# Copy to .env and fill in all required values before deploying.
# =============================================================================

# --- Mode ---
# Set to "false" for production. "true" bypasses Stripe/OpenAI requirements.
DEV_MODE=false

# --- OpenAI (REQUIRED) ---
# API key for contract analysis LLM calls.
OPENAI_API_KEY=sk-your-openai-api-key
# Model used for LLM evaluation. gpt-4o-mini is cost-effective for triage.
OPENAI_MODEL=gpt-4o-mini

# --- Stripe (REQUIRED in production) ---
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs from https://dashboard.stripe.com/products (one per plan/billing period)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_...
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_YEARLY_PRICE_ID=price_...
STRIPE_UNLIMITED_MONTHLY_PRICE_ID=price_...
STRIPE_UNLIMITED_YEARLY_PRICE_ID=price_...

# --- Database ---
# Set automatically by docker-compose. Override only for external databases.
# DATABASE_URL=postgresql://triage:password@postgres:5432/triage

# --- Redis ---
# Set automatically by docker-compose. Override only for external Redis.
# REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (used by docker-compose) ---
# Strong random password for the database. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# --- Security (REQUIRED — change from defaults) ---
# HMAC secret for signing anonymous session tokens. Must be >=32 chars and
# not the dev default — the app refuses to start in production otherwise.
# Generate with: openssl rand -hex 32
APP_HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
# Secret associated with session cookies. Must be >=32 chars and not the dev
# default — the app refuses to start in production otherwise.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
# Marks session cookies as Secure (requires HTTPS). Defaults to "true"
# automatically outside DEV_MODE — only set this if you need to explicitly
# override that default (e.g. "false" for a proxy that terminates TLS but
# talks plain HTTP to the app).
SECURE_COOKIES=true

# --- Encryption at rest (REQUIRED in production) ---
# Contract/playbook text is encrypted at rest with AES-256-GCM (see
# encryption.py). Format: comma-separated "key_id:base64key" pairs, each key
# exactly 256 bits. Generate a key with: openssl rand -base64 32
#   ENCRYPTION_KEYS=k1:BASE64_32_BYTE_KEY
#   ENCRYPTION_KEY_CURRENT=k1
# To rotate: generate a new key, add it alongside the old one, and point
# ENCRYPTION_KEY_CURRENT at the new key id. Old rows keep decrypting under
# the retired key id; run `python backfill_encryption.py` to re-encrypt them
# under the new current key on your own schedule (not automatic).
#   ENCRYPTION_KEYS=k1:BASE64_OLD_KEY,k2:BASE64_NEW_KEY
#   ENCRYPTION_KEY_CURRENT=k2
# Leave unset only for local development — a fixed, clearly-insecure dev key
# is used automatically when DEV_MODE=true and this is unset. The app
# refuses to start in production without it.
ENCRYPTION_KEYS=k1:CHANGE_ME_RUN_openssl_rand_-base64_32
ENCRYPTION_KEY_CURRENT=k1

# --- Application ---
# Public URL of your deployment (no trailing slash).
BASE_URL=https://your-domain.com

# --- Gunicorn ---
# Number of gunicorn workers. 2 is optimal for a 2 vCPU server.
WEB_WORKERS=2

# --- Worker (background job processing) ---
# Enable background task processing.
WORKER_ENABLED=true

# --- Upload malware scanning (optional) ---
# Uploaded files are always checked for magic-byte/content-type mismatches,
# zip-bomb characteristics (.docx), and PDF page/size limits (see
# upload_security.py) regardless of this setting. Actual malware scanning
# requires a running ClamAV daemon (clamd) — see
# docs/security/upload_hardening_infra.md for setup. Leave unset to run
# without malware scanning (the other checks still apply).
# MALWARE_SCANNER=clamd
# CLAMD_HOST=localhost
# CLAMD_PORT=3310

# --- RBAC bootstrap (optional) ---
# Admin access is role-based (see rbac.py / models.py: Role, Permission,
# UserRole) — not a hardcoded email. On a brand-new deployment with no
# admin yet, set this to the email of the account that should become the
# first admin; it's granted the "admin" role once, automatically, the
# first time that user exists and no admin has been assigned yet. Manage
# further role assignments with: python manage_roles.py grant <email> admin
# INITIAL_ADMIN_EMAIL=you@yourfirm.com

# --- Data retention (optional) ---
# Off by default — contracts are kept indefinitely unless you opt in.
# Setting this enables automatic permanent deletion of contracts older
# than N days since upload (see retention.py). Actually running cleanup on
# a schedule requires ONE of:
#   - run_retention_cleanup.py via cron/systemd timer/Kubernetes CronJob
#     (the Docker deployment) — see docs/security/data_retention_infra.md
#   - POST /internal/retention/cleanup with `Authorization: Bearer
#     <CRON_SECRET>` (e.g. Vercel Cron Jobs, for the serverless deployment)
# Setting CONTRACT_RETENTION_DAYS alone does NOT start deleting anything —
# one of the above must actually invoke the cleanup.
# CONTRACT_RETENTION_DAYS=365
# Required to enable the HTTP cleanup endpoint at all — without it, POST
# /internal/retention/cleanup always 404s. Generate with: openssl rand -hex 32
# CRON_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# --- Transactional email (optional) ---
# Required for password-reset emails and the early-access notification below.
# Set either RESEND_API_KEY or SMTP_HOST — see emailer.py. Leave both unset
# to run without outbound email (affected features degrade gracefully).
# RESEND_API_KEY=re_your-resend-api-key
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Triage Counsel <no-reply@yourdomain.com>

# --- Early access requests (optional) ---
# Every /early-access submission is always persisted to the audit log
# (event_type="early_access_request") regardless of this setting. Set this
# to also get an email notification per submission — requires the
# transactional email config above.
# EARLY_ACCESS_NOTIFY_EMAIL=you@yourfirm.com

# --- Analytics (optional) ---
# See docs/architecture/analytics_architecture.md. Cloudflare/proxy headers
# and the ip-api.com fallback work out of the box with no config below.
# Paths to MaxMind GeoLite2 .mmdb files for local, network-free geolocation.
# GEOIP_CITY_DB_PATH=/path/to/GeoLite2-City.mmdb
# GEOIP_ASN_DB_PATH=/path/to/GeoLite2-ASN.mmdb
# Set "false" to disable the ip-api.com network fallback entirely.
IP_API_FALLBACK_ENABLED=true
